# TraceForge Environment Variables

# Etherscan API Key (Free tier: https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# Database Connection (PostgreSQL or SQLite fallback for local development)
# For Postgres (Local/Render): postgresql://username:password@localhost:5432/traceforge
# For local zero-setup dev: sqlite:///./traceforge.db
DATABASE_URL=sqlite:///./traceforge.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Alchemy API Key (for real-time Ethereum transaction WebSocket listener)
ALCHEMY_API_KEY=
